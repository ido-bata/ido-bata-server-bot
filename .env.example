# Reference only — schema for the secrets this bot needs at runtime.
#
# Real values MUST be sourced from a secret manager, CI secret, or
# exported shell variable — NOT committed to the repo. The bot refuses
# to start (with a Zod validation error) if any *required* variable below
# is missing or empty.
#
# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional — privileged Message Content intent must also be enabled on the
# Discord Developer Portal side.
DISCORD_ENABLE_MESSAGE_CONTENT=false

# Optional — runs the timekeeper session immediately on ClientReady and
# compresses in-session minutes to 1 second for fast iteration.
TIMEKEEPER_RUN_ON_READY=false

# Optional — consent registry. When CONSENT_MESSAGE_ID is set the bot
# treats reactions on that message as (emoji -> ConsentScope) grants and
# persists them to data/consent.json (gitignored). Leave it empty to
# disable the consent flow entirely.
#
# CONSENT_EMOJI accepts either a single emoji (default scope: profile)
# or a comma-separated list of <emoji>:<scope> pairs. Supported scopes:
# activity-history, presence-history, profile, message-history.
#
# CONSENT_POLICY_VERSION is the privacy policy version the registry
# recognises as current -- bump it on privacy-policy changes so old grants
# are surfaced as wrong-policy by ConsentService.authorize().
# CONSENT_MESSAGE_ID=
# CONSENT_CHANNEL_ID=
# CONSENT_GUILD_ID=
# CONSENT_EMOJI=✅
# CONSENT_POLICY_VERSION=v0.2.0
