# Reference only — schema for the secrets this bot needs at runtime.
#
# Real values MUST be sourced from a secret manager, CI secret, or
# exported shell variable — NOT committed to the repo. The bot refuses
# to start (with a Zod validation error) if any *required* variable below
# is missing or empty.
#
# Required
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional — privileged Message Content intent must also be enabled on the
# Discord Developer Portal side.
DISCORD_ENABLE_MESSAGE_CONTENT=false

# Optional — runs the timekeeper session immediately on ClientReady and
# compresses in-session minutes to 1 second for fast iteration.
TIMEKEEPER_RUN_ON_READY=false

# Optional — structured-logger configuration. See docs/observability.md.
# One of: fatal | error | warn | info | debug | trace | silent. Defaults to info.
LOG_LEVEL=info
# Capacity (10..10000) of the in-memory ring buffer that backs the recent
# events stream consumed by the TUI log panel and structured subscribers.
LOG_RING_SIZE=200

# Optional — runtime TUI dashboard. One of: auto | on | off.
#   auto (default) — render TUI when stdout+stdin are TTYs and CI/TERM=dumb
#                    are not; otherwise behave as `off`.
#   on             — always mount the TUI even in non-TTY environments
#                    (useful for local debugging with `script` or tmux).
#   off            — never mount the TUI; the structured logger continues
#                    to emit JSON Lines for downstream consumers.
BOT_TUI=auto
# Optional — consent registry. Set CONSENT_CHANNEL_ID to enable it.
# On ClientReady the bot reuses its own managed consent message in that
# channel, or posts one automatically when none exists. CONSENT_MESSAGE_ID
# is only an override for an existing message; it is not required.
#
# When CONSENT_EMOJI is omitted the bot uses all four default mappings:
# 📊 activity-history, 🟢 presence-history, 👤 profile, 💬 message-history.
# To customize them, use comma-separated <emoji>:<scope> pairs.
#
# CONSENT_POLICY_VERSION is the privacy policy version the registry
# recognises as current -- bump it on privacy-policy changes so old grants
# are surfaced as wrong-policy by ConsentService.authorize().
# CONSENT_CHANNEL_ID=
# CONSENT_GUILD_ID=
# CONSENT_MESSAGE_ID=
# CONSENT_EMOJI=📊:activity-history,🟢:presence-history,👤:profile,💬:message-history
# CONSENT_POLICY_VERSION=v0.2.0
# Optional — persistence backend (ADR-0004). One of: local | u3 | valkey.
#   valkey          — Redis-compatible store (Altare Valkey). VALKEY_URL or
#                     REDIS_URL is required; VALKEY_PREFIX namespaces keys.
#   local (default) — files under DATA_DIR (default <cwd>/data). Behaviour of
#                     the original single-host deployment.
#   u3              — S3-compatible object storage (Altare U3). The source of
#                     truth on Altare: a GitHub-linked deploy rebuilds the app
#                     from the repository, so runtime files on the app disk are
#                     not durable. Set S3_* / AWS_* (Altare's "Connect to app"
#                     injects them automatically) and never commit them.
STORAGE_BACKEND=local
# DATA_DIR only applies to the local backend.
# DATA_DIR=./data
# S3_ENDPOINT=https://u3-eu.altare.global
# S3_REGION=eu
# S3_BUCKET=ido-bata-bot
# S3_PREFIX=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Optional — the instance lease uses its own backend so that two hosts can
# contend for the SAME lease during a migration cutover. Defaults to the data
# backend above. U3 does NOT implement S3 conditional writes (verified live),
# so on Altare the lease runs on Valkey instead:
#   LEASE_STORAGE_BACKEND=valkey   (REDIS_URL is injected by `altr valkey
#                                attach`; LEASE_VALKEY_URL / LEASE_REDIS_URL
#                                override it, LEASE_VALKEY_PREFIX namespaces)
# During the cutover set this on the OLD host as well, pointing at the same
# Valkey instance — otherwise its lease stays in the local data/ directory,
# where the Altare instance cannot see it and the double-run guard is void.
# LEASE_STORAGE_BACKEND=valkey
# LEASE_VALKEY_URL=
# LEASE_VALKEY_PREFIX=
#
# Optional — `rediss://` certificate verification for the valkey backend.
# Altare Valkey serves a self-signed certificate made for the instance;
# download it from the instance's console page ("Download certificate")
# and set it here. VALKEY_TLS_CA takes the PEM inline (literal \n works)
# or VALKEY_TLS_CA_FILE a path; LEASE_VALKEY_TLS_* overrides for the
# lease backend. REDIS_TLS_CA / REDIS_TLS_CA_FILE / REDIS_TLS_INSECURE
# are accepted aliases for shared Valkey connections. Without a CA,
# verification stays ON and a self-signed endpoint fails closed.
# VALKEY_TLS_INSECURE=true is the explicit opt-out (encrypted but
# MITM-able — last resort only).
# VALKEY_TLS_CA=
# VALKEY_TLS_CA_FILE=
# VALKEY_TLS_INSECURE=
#
# Optional — HMAC key (>= 16 bytes of entropy) for the deletion ledger
# (`privacy/deletions.json`). The ledger records that a subject's data was
# erased so that restoring an old backup cannot resurrect it. Keep the key in
# the secret manager: without it the ledger cannot be matched and a restore
# of an old backup may bring deleted data back.
# DELETION_LEDGER_KEY=

# Optional — maximum milliseconds to wait for a voice connection to reach
# the Ready state before giving up (and triggering a stage reconnect).
VOICE_CONNECTION_TIMEOUT_MS=30000

# /anon anonymous chat (see docs/adr/0003-anonymous-chat.md).
# ANON_DENY_CHANNEL_IDS: comma-separated channel ids where /anon is always
# denied (supplementary deny-list; the effective-permission check still applies).
# ANON_COOLDOWN_SECONDS / ANON_MAX_MESSAGE_LENGTH: per-user attempt cooldown
# and max trimmed body length.
# ANON_AUDIT_PUBLIC_KEY: RSA public key (PEM or base64 SPKI). REQUIRED —
# audit is mandatory (Issue #118): unset or malformed makes /anon refuse all
# posts; there is no unlogged posting mode. Each post stores encrypted
# attempt + posted (messageId-linked) records in data/anon-audit/
# (90-day retention, ciphertext only, no per-user index; selective deletion
# and messageId correlation run offline via `bun run anon:audit:delete` /
# `bun run anon:audit:lookup`). The RSA PRIVATE key must be kept OFF the
# bot host — only the public key goes here.
# ANON_AUDIT_KEY_ID: optional key id written into record envelopes
# (default v1); bump when rotating keys.
# ANON_AUDIT_INDEX_KEY is removed — ignored with a warning if still set.
# ANON_DENY_CHANNEL_IDS=
# ANON_COOLDOWN_SECONDS=30
# ANON_MAX_MESSAGE_LENGTH=1000
# ANON_AUDIT_PUBLIC_KEY=
# ANON_AUDIT_KEY_ID=v1
# ANON_AUDIT_DIR: storage key prefix for the audit records (default
# "anon-audit" → data/anon-audit locally, anon-audit/ in the bucket).
# ANON_AUDIT_RETENTION_DAYS=90
