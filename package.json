{
  "name": "ido-bata-server-bot",
  "version": "0.1.0",
  "description": "Discord server bot for ido-bata operations",
  "main": "dist/index.js",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "audit": "bun audit --production",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "knip": "knip",
    "lint": "eslint .",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:stage": "tsx src/scripts/stage-audio-smoke.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.0",
    "knip": "^6.32.0",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1",
    "zod": "^4.4.3"
  }
}
