{
  "name": "ido-bata-server-bot",
  "version": "0.2.1",
  "description": "Discord server bot for ido-bata operations",
  "main": "dist/index.js",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "audit": "bun audit --production",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "knip": "knip",
    "lint": "eslint .",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke:stage": "tsx src/scripts/stage-audio-smoke.ts",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "restore:state": "tsx src/scripts/restore-snapshot.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "type-check": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.0",
    "eslint": "^10.10.0",
    "knip": "^6.34.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ink": "^7.1.1",
    "node-ical": "^0.27.1",
    "opusscript": "^0.1.1",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "split2": "^1.0.0",
    "zod": "^4.5.4"
  }
}
